  // ============================================================
  // ACTIONS — wired to real FastAPI backend endpoints
  // ============================================================
  async function setStatus(appId, status) {
    const a = state.applications.find(x => x.id === appId);
    if (a) {
      a.status = status;
      const tones = { applied:"warning", interview:"success", rejected:"danger", skipped:"muted", approved:"accent" };
      const labels = { applied:"Applied", interview:"Interview", rejected:"Rejected", skipped:"Skipped", approved:"Approved" };
      a.status_meta = { label: labels[status] || status, tone: tones[status] || "neutral" };
      if (status === "applied") { a.date_applied = new Date().toISOString(); a.days_since_applied = 0; }
    }
    showToast(`Marking ${status}…`);
    renderTable(state.applications);
    closeDrawer();
    try {
      const res = await fetch(`/api/application/${appId}/status`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status }),
      });
      if (res.ok) {
        showToast(`Marked ${status}`);
        setTimeout(() => loadData(), 500);
      } else {
        showToast(`Save failed · ${res.status}`);
      }
    } catch {
      showToast("Network error");
    }
  }

  async function saveNotes(appId) {
    const notes = $("notes-input") ? $("notes-input").value : "";
    const a = state.applications.find(x => x.id === appId);
    if (a) a.notes = notes;
    try {
      const res = await fetch(`/api/application/${appId}/notes`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ notes }),
      });
      showToast(res.ok ? "Notes saved" : "Failed to save notes");
    } catch {
      showToast("Network error");
    }
  }

  async function openJobLink(appId) {
    showToast("Opening posting…");
    try {
      const res = await fetch(`/api/application/${appId}/open-link`, { method: "POST" });
      if (!res.ok) {
        const a = state.applications.find(x => x.id === appId);
        if (a && a.url && a.url !== "#") window.open(a.url, "_blank");
      }
    } catch {
      const a = state.applications.find(x => x.id === appId);
      if (a && a.url && a.url !== "#") window.open(a.url, "_blank");
    }
  }

