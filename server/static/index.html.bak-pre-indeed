<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cromaz AI · Job Search Helper</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     CROMAZ AI · Job Search Helper
     Navy + steel-blue + cyan accent — professional, restrained
     Type: Manrope (UI) / IBM Plex Mono (data)
     ============================================================ */

  :root {
    /* Surface — soft, professional light theme */
    --bg:           #f5f7fb;
    --bg-2:         #eef2f8;
    --surface:      #ffffff;
    --surface-2:    #fafbfd;
    --surface-3:    #f1f4fa;
    --line:         #e3e8f0;
    --line-2:       #d4dbe7;
    --line-3:       #c1cad9;

    /* Text */
    --ink:          #0e1a32;
    --ink-2:        #1d2b48;
    --ink-3:        #2e3e5e;
    --muted:        #5b6a87;
    --muted-2:      #7c89a3;
    --muted-3:      #a3aec3;

    /* Brand — pulled from logo */
    --navy:         #0e2756;
    --navy-deep:    #0a1c40;
    --blue:         #2563eb;
    --blue-2:       #3b82f6;
    --steel:        #4b6bb5;
    --teal:         #2ea7a0;
    --cyan-soft:    #5fb8c9;

    /* Status (muted, professional) */
    --success:      #2f8a5f;
    --success-bg:   #e8f4ee;
    --warning:      #b87a16;
    --warning-bg:   #fbf2dc;
    --danger:       #b04545;
    --danger-bg:    #f8e7e7;
    --info:         #2563eb;
    --info-bg:      #e7eefe;

    /* Type */
    --sans: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "IBM Plex Mono", "SF Mono", monospace;

    --ease-out:  cubic-bezier(0.2, 0.8, 0.2, 1);
    --ease-cine: cubic-bezier(0.6, 0, 0.2, 1);
    --ease-snap: cubic-bezier(0.34, 1.56, 0.64, 1);

    --shadow-sm: 0 1px 2px rgba(14, 39, 86, 0.04), 0 1px 3px rgba(14, 39, 86, 0.06);
    --shadow-md: 0 4px 12px rgba(14, 39, 86, 0.06), 0 2px 4px rgba(14, 39, 86, 0.04);
    --shadow-lg: 0 14px 40px rgba(14, 39, 86, 0.10), 0 4px 12px rgba(14, 39, 86, 0.06);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    letter-spacing: -0.005em;
  }

  /* Subtle ambient backdrop — barely there */
  body::before {
    content: "";
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(1100px 600px at 12% -10%, rgba(37,99,235,0.06), transparent 60%),
      radial-gradient(900px 500px at 90% 110%, rgba(46,167,160,0.05), transparent 60%);
  }
  body::after {
    content: "";
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(14,39,86,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(14,39,86,0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
  }

  ::selection { background: rgba(37,99,235,0.18); color: var(--navy); }

  /* ============================================================
     LAYOUT
     ============================================================ */
  .app {
    position: relative; z-index: 1;
    max-width: 1640px;
    margin: 0 auto;
    padding: 28px 40px 96px;
  }

  /* ============================================================
     TOPBAR
     ============================================================ */
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 20px;
    margin-bottom: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    height: 96px;
    padding: 8px 24px;
  }

  .brand { display: flex; align-items: center; gap: 18px; }
  .brand-logo {
    height: 80px;
    width: auto;
    display: block;
    object-fit: contain;
  }
  .brand-divider {
    width: 1px;
    height: 28px;
    background: var(--line);
  }
  .brand-title {
    display: flex; flex-direction: column; gap: 2px;
  }
  .brand-app-name {
    font-weight: 700;
    font-size: 14px;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .brand-tagline {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .topbar-meta {
    display: flex; gap: 10px; align-items: center;
  }
  .meta-chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 11px;
  }
  .meta-chip .k {
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 10px;
  }
  .meta-chip .v {
    color: var(--ink-2);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .live-chip {
    padding: 8px 14px;
    background: var(--success-bg);
    border: 1px solid rgba(47, 138, 95, 0.25);
    border-radius: 8px;
    color: var(--success);
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .live-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 rgba(47,138,95,0.45);
    animation: pulse-live 2s ease-in-out infinite;
  }
  @keyframes pulse-live {
    0%,100% { box-shadow: 0 0 0 0 rgba(47,138,95,0.45); }
    50%     { box-shadow: 0 0 0 5px rgba(47,138,95,0); }
  }

  /* ============================================================
     HEADER
     ============================================================ */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    padding: 6px 4px 22px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--line);
    gap: 32px;
  }
  .page-eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 10px;
    font-weight: 500;
  }
  .page-title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 38px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--navy);
  }
  .page-subtitle {
    margin-top: 8px;
    color: var(--muted);
    font-size: 14px;
    max-width: 560px;
  }
  .page-rail {
    text-align: right;
    display: flex; flex-direction: column; gap: 4px;
    min-width: 200px;
    padding-bottom: 6px;
  }
  .page-rail .label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted-2);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .page-rail .value {
    font-size: 13px;
    color: var(--ink-2);
    font-weight: 500;
  }

  /* ============================================================
     STATS — clean cards
     ============================================================ */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  .stat {
    position: relative;
    padding: 22px 22px 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), border-color 0.3s, box-shadow 0.3s;
    box-shadow: var(--shadow-sm);
    opacity: 1;
  }
  .stat::before {
    content: "";
    position: absolute;
    top: 0; left: 0;
    width: 3px; height: 100%;
    background: var(--accent, var(--blue));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.6s var(--ease-cine);
  }
  .is-ready .stat::before { transform: scaleY(1); }
  .stat:hover {
    transform: translateY(-2px);
    border-color: var(--line-2);
    box-shadow: var(--shadow-md);
  }

  .stat.blue    { --accent: var(--blue); }
  .stat.steel   { --accent: var(--steel); }
  .stat.teal    { --accent: var(--teal); }
  .stat.navy    { --accent: var(--navy); }
  .stat.warning { --accent: var(--warning); }
  .stat.success { --accent: var(--success); }

  .is-ready .stat {
    animation: stat-in 0.7s var(--ease-cine) both;
  }
  @keyframes stat-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .is-ready .stat:nth-child(1) { animation-delay: 0.05s; }
  .is-ready .stat:nth-child(2) { animation-delay: 0.10s; }
  .is-ready .stat:nth-child(3) { animation-delay: 0.15s; }
  .is-ready .stat:nth-child(4) { animation-delay: 0.20s; }
  .is-ready .stat:nth-child(5) { animation-delay: 0.25s; }
  .is-ready .stat:nth-child(6) { animation-delay: 0.30s; }
  .is-ready .stat:nth-child(7) { animation-delay: 0.35s; }
  .is-ready .stat:nth-child(8) { animation-delay: 0.40s; }

  .stat-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .stat-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .stat-delta-chip {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 5px;
    background: var(--surface-3);
    color: var(--muted);
    font-weight: 500;
  }
  .stat-delta-chip.up    { color: var(--success); background: var(--success-bg); }
  .stat-delta-chip.warn  { color: var(--warning); background: var(--warning-bg); }
  .stat-delta-chip.down  { color: var(--danger);  background: var(--danger-bg); }

  .stat-value {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    display: flex; align-items: baseline; gap: 4px;
  }
  .stat-value .suffix {
    font-size: 18px;
    color: var(--muted-2);
    font-weight: 500;
    margin-left: 2px;
  }

  .stat-footer {
    margin-top: 14px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px;
  }
  .stat-caption {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted-2);
  }
  .spark { width: 88px; height: 26px; flex-shrink: 0; }
  .spark path.line {
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .spark path.fill { opacity: 1; }
  .is-ready .spark path.line {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: draw-spark 1.4s var(--ease-cine) 0.6s forwards;
  }
  .is-ready .spark path.fill {
    opacity: 0;
    animation: fade-in 1.0s ease 1.3s forwards;
  }
  @keyframes draw-spark { to { stroke-dashoffset: 0; } }
  @keyframes fade-in    { to { opacity: 1; } }

  /* ============================================================
     SECTION HEADERS
     ============================================================ */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
    gap: 18px;
  }
  .section-title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.01em;
    color: var(--navy);
    display: flex; align-items: baseline; gap: 12px;
  }
  .section-title .tag {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--muted-2);
    text-transform: uppercase;
    font-weight: 500;
  }
  .section-title em {
    font-weight: 400;
    color: var(--muted);
    font-size: 13px;
    font-style: normal;
    margin-left: 4px;
  }
  .section-note {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted-2);
  }

  /* ============================================================
     PIPELINE
     ============================================================ */
  .pipeline-section { margin-bottom: 30px; }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 8px;
    padding: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .pipe-node {
    position: relative;
    padding: 18px 14px 16px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    font-family: var(--sans);
    transition: background 0.25s, border-color 0.25s, transform 0.25s var(--ease-out);
  }
  .pipe-node:hover {
    background: var(--surface);
    border-color: var(--line-3);
    transform: translateY(-1px);
  }
  .pipe-node.active {
    background: var(--info-bg);
    border-color: var(--blue);
  }
  .pipe-node.success { --node-accent: var(--success); }
  .pipe-node.warning { --node-accent: var(--warning); }
  .pipe-node.danger  { --node-accent: var(--danger); }
  .pipe-node:not(.success):not(.warning):not(.danger) { --node-accent: var(--blue); }

  .pipe-node .bar-track {
    position: absolute;
    left: 14px; right: 14px; bottom: 10px;
    height: 3px;
    background: var(--line);
    border-radius: 3px;
    overflow: hidden;
  }
  .pipe-node .bar-fill {
    height: 100%;
    background: var(--node-accent);
    border-radius: 3px;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.0s var(--ease-cine);
  }
  .is-ready .pipe-node .bar-fill { transform: scaleX(var(--bar-pct, 0)); }

  .pipe-stage {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--muted-3);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .pipe-label {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 12px;
    color: var(--ink-2);
    margin-bottom: 12px;
  }
  .pipe-count {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 32px;
    line-height: 1;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    margin-bottom: 18px;
    letter-spacing: -0.02em;
  }
  .pipe-node.success .pipe-count { color: var(--success); }
  .pipe-node.warning .pipe-count { color: var(--warning); }
  .pipe-node.danger  .pipe-count { color: var(--danger); }

  /* ============================================================
     CONTROLS
     ============================================================ */
  .controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    gap: 14px;
    flex-wrap: wrap;
  }

  .filter-pills {
    display: inline-flex;
    gap: 2px;
    padding: 4px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }
  .filter-pill {
    padding: 9px 14px;
    font-family: var(--sans);
    font-size: 12px;
    color: var(--muted);
    background: transparent;
    border: none;
    border-radius: 7px;
    cursor: pointer;
    transition: color 0.2s, background 0.25s;
    font-weight: 500;
    display: inline-flex; align-items: center; gap: 7px;
  }
  .filter-pill:hover:not(.active) {
    color: var(--ink-2);
    background: var(--surface-3);
  }
  .filter-pill.active {
    color: #fff;
    background: var(--blue);
    box-shadow: 0 1px 2px rgba(37,99,235,0.3);
  }
  .filter-pill .cnt {
    font-family: var(--mono);
    font-size: 10px;
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--surface-3);
    color: var(--muted);
  }
  .filter-pill.active .cnt { background: rgba(255,255,255,0.22); color: #fff; }

  .search-bar {
    position: relative;
    flex: 1;
    max-width: 380px;
    min-width: 220px;
  }
  .search-bar input {
    width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 11px 14px 11px 38px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-shadow: var(--shadow-sm);
  }
  .search-bar input:focus {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
  }
  .search-bar input::placeholder { color: var(--muted-3); }
  .search-bar::before {
    content: "";
    position: absolute;
    left: 14px; top: 50%;
    width: 12px; height: 12px;
    transform: translateY(-50%);
    border: 1.6px solid var(--muted-2);
    border-radius: 50%;
  }
  .search-bar::after {
    content: "";
    position: absolute;
    left: 23px;
    top: calc(50% + 4px);
    width: 7px; height: 1.6px;
    background: var(--muted-2);
    transform: rotate(45deg);
    border-radius: 2px;
  }

  .result-count {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .result-count em {
    font-style: normal;
    color: var(--blue);
    font-weight: 600;
  }

  /* ============================================================
     TABLE
     ============================================================ */
  .table-frame {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  table.applications {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sans);
  }
  table.applications thead {
    background: var(--surface-3);
    border-bottom: 1px solid var(--line);
  }
  table.applications th {
    padding: 13px 18px;
    text-align: left;
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
    white-space: nowrap;
  }
  table.applications tbody tr {
    border-top: 1px solid var(--line);
    transition: background 0.2s ease;
    cursor: pointer;
    opacity: 1;
  }
  .is-ready table.applications tbody tr {
    opacity: 0;
    animation: row-in 0.5s var(--ease-cine) forwards;
  }
  @keyframes row-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  table.applications tbody tr:hover { background: var(--surface-3); }
  table.applications tbody tr:hover .cell-company { color: var(--blue); }
  table.applications tbody tr.selected {
    background: var(--info-bg);
    box-shadow: inset 3px 0 0 var(--blue);
  }
  table.applications td {
    padding: 14px 18px;
    font-size: 13px;
    color: var(--ink-2);
    vertical-align: middle;
  }

  .cell-score { width: 64px; }
  .score-chip {
    position: relative;
    width: 44px; height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .score-chip svg {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    transform: rotate(-90deg);
  }
  .score-chip svg circle { fill: none; stroke-width: 2.5; }
  .score-chip svg .bg { stroke: var(--line); }
  .score-chip svg .fg { stroke-linecap: round; transition: stroke-dashoffset 1.0s var(--ease-cine); }
  .score-num {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 14px;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    position: relative; z-index: 1;
    letter-spacing: -0.01em;
  }
  .score-chip.high .fg    { stroke: var(--success); }
  .score-chip.high .score-num { color: var(--success); }
  .score-chip.mid  .fg    { stroke: var(--warning); }
  .score-chip.mid  .score-num  { color: var(--warning); }
  .score-chip.low  .fg    { stroke: var(--muted-2); }
  .score-chip.low  .score-num  { color: var(--muted); }
  .score-chip.unscored .score-num { color: var(--muted-3); font-size: 14px; }

  .cell-company {
    color: var(--ink);
    font-weight: 600;
    transition: color 0.2s;
    white-space: nowrap;
  }
  .cell-title {
    color: var(--ink-3);
    max-width: 280px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
  }
  /* Status column — needs to fit "MATERIALS READY" without clipping */
  table.applications th.col-status,
  table.applications td.col-status {
    width: 168px;
    min-width: 168px;
    padding-left: 14px;
    padding-right: 14px;
  }
  .cell-location { color: var(--muted); font-size: 12px; white-space: nowrap; }
  .cell-source {
    color: var(--muted-2);
    font-family: var(--mono);
    font-size: 11px;
    text-transform: lowercase;
    white-space: nowrap;
  }
  .cell-age {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cell-age.fresh { color: var(--blue); font-weight: 500; }
  .cell-age.fresh::before {
    content: "";
    display: inline-block;
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--blue);
    margin-right: 6px;
    vertical-align: middle;
    animation: pulse-live 2s ease infinite;
  }

  /* Status */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    font-family: var(--sans);
    font-size: 10.5px;
    letter-spacing: 0.02em;
    border-radius: 6px;
    font-weight: 600;
    white-space: nowrap;
    max-width: 100%;
  }
  .status::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .status.neutral { color: var(--muted);   background: var(--surface-3); }
  .status.info    { color: var(--info);    background: var(--info-bg); }
  .status.accent  { color: var(--warning); background: var(--warning-bg); }
  .status.warning { color: var(--warning); background: var(--warning-bg); }
  .status.success { color: var(--success); background: var(--success-bg); }
  .status.success::before { animation: status-pulse 2s ease infinite; }
  .status.danger  { color: var(--danger);  background: var(--danger-bg); }
  .status.muted   { color: var(--muted-2); background: var(--surface-3); }
  @keyframes status-pulse {
    0%,100% { transform: scale(1); }
    50%     { transform: scale(1.4); }
  }

  /* Assets */
  .asset-indicators { display: flex; gap: 5px; align-items: center; }
  .asset {
    width: 28px; height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted-3);
    font-weight: 600;
    transition: all 0.2s;
  }
  .asset.active {
    color: #fff;
    background: var(--blue);
    border-color: var(--blue);
  }
  .asset.bot {
    color: #fff;
    background: linear-gradient(135deg, var(--teal), var(--steel));
    border-color: var(--teal);
    box-shadow: 0 1px 4px rgba(46,167,160,0.3);
    animation: bot-pulse 2.4s ease-in-out infinite;
  }
  @keyframes bot-pulse {
    0%,100% { box-shadow: 0 1px 4px rgba(46,167,160,0.3); }
    50%     { box-shadow: 0 2px 10px rgba(46,167,160,0.45); }
  }

  /* Auto-apply banner inside drawer */
  .auto-apply-banner {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; margin-bottom: 16px;
    background: linear-gradient(135deg, rgba(46,167,160,0.10), rgba(37,99,235,0.06));
    border: 1px solid rgba(46,167,160,0.30);
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--teal);
    font-weight: 500;
  }
  .auto-apply-banner .glyph { font-size: 14px; color: var(--teal); }
  .auto-apply-banner .ts {
    margin-left: auto;
    font-size: 10px;
    letter-spacing: 0.10em;
    color: var(--muted-2);
    font-weight: 400;
  }

  /* Empty */
  .empty { padding: 80px 32px; text-align: center; }
  .empty h2 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 20px;
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  .empty p { color: var(--muted); font-size: 13px; }

  /* ============================================================
     TICKER
     ============================================================ */
  .ticker {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--navy);
    padding: 0;
    z-index: 10;
    overflow: hidden;
    height: 40px;
    box-shadow: 0 -4px 20px rgba(14,39,86,0.12);
  }
  .ticker-label {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 170px;
    background: var(--navy-deep);
    display: flex;
    align-items: center;
    padding-left: 22px;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    z-index: 2;
    font-weight: 600;
  }
  .ticker-label .micro-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--cyan-soft);
    box-shadow: 0 0 0 0 rgba(95,184,201,0.5);
    animation: pulse-cyan 2s ease infinite;
  }
  @keyframes pulse-cyan {
    0%,100% { box-shadow: 0 0 0 0 rgba(95,184,201,0.55); }
    50%     { box-shadow: 0 0 0 5px rgba(95,184,201,0); }
  }
  .ticker-track {
    padding-left: 184px;
    white-space: nowrap;
    animation: ticker-scroll 90s linear infinite;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .ticker:hover .ticker-track { animation-play-state: paused; }
  @keyframes ticker-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    margin-right: 40px;
    font-family: var(--mono);
    font-size: 11px;
    color: rgba(255,255,255,0.78);
    gap: 10px;
  }
  .ticker-item .tick-tag {
    color: var(--navy);
    background: var(--cyan-soft);
    padding: 3px 7px;
    border-radius: 4px;
    font-size: 9px;
    letter-spacing: 0.14em;
    font-weight: 700;
  }
  .ticker-item .tick-tag.applied,
  .ticker-item .tick-tag.materials { background: #b6d4ff; }
  .ticker-item .tick-tag.interview { background: #b9e5cd; }
  .ticker-item .tick-tag.rejected  { background: #f4c5c5; }
  .ticker-item .tick-tag.found     { background: var(--cyan-soft); }
  .ticker-item .tick-tag.scored    { background: #f3d896; }
  .ticker-item .tick-company {
    color: #fff;
    font-weight: 600;
    font-family: var(--sans);
  }
  .ticker-item .tick-sep { color: rgba(255,255,255,0.3); }
  .ticker-item .tick-time {
    color: rgba(255,255,255,0.5);
    font-variant-numeric: tabular-nums;
    font-size: 10px;
  }

  /* ============================================================
     DRAWER
     ============================================================ */
  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(14,39,86,0.4);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 50;
  }
  .drawer-overlay.open { opacity: 1; pointer-events: auto; }

  .drawer {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(720px, 92vw);
    background: var(--surface);
    border-left: 1px solid var(--line);
    transform: translateX(102%);
    transition: transform 0.45s var(--ease-cine);
    z-index: 60;
    overflow-y: auto;
    box-shadow: -20px 0 60px rgba(14,39,86,0.18);
  }
  .drawer.open { transform: translateX(0); }

  .drawer-inner { padding: 38px 44px 110px; }

  .drawer-close {
    position: absolute;
    top: 22px; right: 24px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    color: var(--muted);
    width: 36px; height: 36px;
    border-radius: 8px;
    font-family: var(--mono);
    font-size: 13px;
    cursor: pointer;
    transition: all 0.25s var(--ease-out);
    z-index: 2;
  }
  .drawer-close:hover {
    border-color: var(--danger);
    color: var(--danger);
    background: var(--danger-bg);
    transform: rotate(90deg);
  }

  .drawer-company {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: 8px;
    display: flex; align-items: center; gap: 12px;
    letter-spacing: 0.02em;
  }
  .drawer-company .src {
    color: var(--muted-2);
    font-weight: 400;
    font-family: var(--mono);
    font-size: 11px;
  }

  .drawer-title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--navy);
    margin-bottom: 22px;
  }

  .drawer-meta-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 22px;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .drawer-meta-item .k {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 5px;
    font-weight: 600;
  }
  .drawer-meta-item .v {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    font-weight: 500;
  }
  .drawer-meta-item .v .remote-tag {
    color: var(--success);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    margin-left: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--success-bg);
    font-weight: 600;
  }

  .drawer-score-block {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
    padding: 22px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .score-visual {
    position: relative;
    width: 88px; height: 88px;
  }
  .score-visual svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .score-visual circle { fill: none; }
  .score-visual .bg { stroke: var(--line-2); stroke-width: 4; }
  .score-visual .fg {
    stroke-width: 4;
    stroke-linecap: round;
    transition: stroke-dashoffset 1.2s var(--ease-cine);
  }
  .score-visual .num {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 30px;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.025em;
  }

  .drawer-reasoning-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
    font-weight: 600;
  }
  .drawer-reasoning {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .drawer-section { margin-bottom: 22px; }
  .drawer-section-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .drawer-section-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    padding: 5px 10px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--sans);
    font-size: 12px;
    color: var(--ink-3);
    transition: transform 0.2s, border-color 0.2s;
  }
  .tag:hover { transform: translateY(-1px); }
  .tag.match   { border-color: rgba(47,138,95,0.3); color: var(--success); background: var(--success-bg); }
  .tag.gap     { border-color: rgba(176,69,69,0.3); color: var(--danger);  background: var(--danger-bg); }
  .tag.keyword { border-color: rgba(37,99,235,0.25); color: var(--blue);   background: var(--info-bg); }

  .drawer-description {
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.65;
    color: var(--ink-3);
    max-height: 260px;
    overflow-y: auto;
    padding: 16px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 10px;
    white-space: pre-wrap;
  }

  /* ============================================================
     Archetype badge — borrowed from career-ops's archetype routing.
     Sits inline with the company name above the role title.
     ============================================================ */
  .archetype-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    background: linear-gradient(135deg, var(--info-bg) 0%, rgba(95,184,201,0.18) 100%);
    border: 1px solid rgba(37,99,235,0.25);
    border-radius: 5px;
    font-family: var(--sans);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .archetype-badge::before {
    content: "◆";
    font-size: 9px;
    color: var(--steel);
  }
  .archetype-badge .conf {
    color: var(--muted-2);
    font-weight: 400;
    font-family: var(--mono);
    font-size: 10px;
    margin-left: 2px;
  }

  /* ============================================================
     Below-threshold banner (when fit_score < archetype's auto_apply_min_score).
     ============================================================ */
  .threshold-banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    background: var(--warning-bg);
    border: 1px solid rgba(184,122,22,0.3);
    border-radius: 8px;
    margin-bottom: 18px;
    font-family: var(--sans);
    font-size: 12.5px;
    color: var(--warning);
  }
  .threshold-banner .glyph { font-size: 14px; }
  .threshold-banner strong { font-weight: 700; }

  /* ============================================================
     Multi-dimensional score bars — 10 dimensions per archetype config.
     Borrowed from career-ops's A-F weighted scoring with mini bar viz.
     ============================================================ */
  .dim-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 22px;
    row-gap: 8px;
    padding: 16px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .dim-row {
    display: grid;
    grid-template-columns: 110px 1fr 36px;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-size: 12px;
  }
  .dim-row .label {
    color: var(--ink-3);
    font-weight: 500;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .dim-row .label .w {
    color: var(--muted-3);
    font-family: var(--mono);
    font-size: 9.5px;
    margin-left: 4px;
  }
  .dim-row .bar {
    position: relative;
    height: 7px;
    background: var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .dim-row .bar .fill {
    position: absolute;
    top: 0; left: 0; bottom: 0;
    border-radius: 4px;
    transition: width 0.8s var(--ease-cine);
    background: var(--blue);
  }
  .dim-row.high  .bar .fill { background: var(--success); }
  .dim-row.mid   .bar .fill { background: var(--warning); }
  .dim-row.low   .bar .fill { background: var(--muted-2); }
  .dim-row .num {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    text-align: right;
    font-weight: 600;
  }
  .dim-row.high  .num { color: var(--success); }
  .dim-row.mid   .num { color: var(--warning); }
  .dim-row.low   .num { color: var(--muted); }

  /* ============================================================
     6-block evaluation panel — collapsible, lazy-loaded markdown report.
     ============================================================ */
  .eval-panel {
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0;
    overflow: hidden;
  }
  .eval-toggle {
    width: 100%;
    text-align: left;
    padding: 12px 16px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink-2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: background 0.2s;
  }
  .eval-toggle:hover { background: rgba(37,99,235,0.04); }
  .eval-toggle .arrow {
    transition: transform 0.3s var(--ease-out);
    font-family: var(--mono);
    color: var(--muted-2);
    font-size: 11px;
  }
  .eval-panel.open .eval-toggle .arrow { transform: rotate(90deg); }
  .eval-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s var(--ease-cine);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .eval-panel.open .eval-body { max-height: 2400px; }
  .eval-body-inner {
    padding: 16px 20px 22px;
  }
  .eval-body-inner h1,
  .eval-body-inner h2 { display: none; }   /* metadata header already shown elsewhere */
  .eval-body-inner h3 {
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    margin: 18px 0 6px;
    letter-spacing: -0.01em;
  }
  .eval-body-inner h3:first-child { margin-top: 0; }
  .eval-body-inner p { margin: 0 0 8px; }
  .eval-body-inner ul { margin: 4px 0 12px 16px; padding: 0; }
  .eval-body-inner ul li { margin-bottom: 4px; list-style: disc; }
  .eval-body-inner strong { color: var(--navy); }
  .eval-body-inner hr { border: none; border-top: 1px solid var(--line); margin: 14px 0; }
  .eval-body-inner code {
    background: var(--bg-2);
    padding: 1px 5px;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .eval-loading {
    padding: 20px;
    color: var(--muted-2);
    font-style: italic;
    font-size: 12.5px;
    text-align: center;
  }

  .drawer-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 22px;
    padding: 22px;
    background: var(--surface-3);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .btn {
    background: var(--surface);
    border: 1px solid var(--line-2);
    color: var(--ink-2);
    padding: 11px 16px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s var(--ease-out);
    border-radius: 8px;
    text-align: center;
  }
  .btn:hover {
    background: var(--surface-3);
    border-color: var(--line-3);
    transform: translateY(-1px);
  }
  .btn:disabled { opacity: 0.45; cursor: not-allowed; transform: none; }
  .btn.primary {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
    grid-column: 1 / -1;
    box-shadow: 0 1px 2px rgba(37,99,235,0.3);
  }
  .btn.primary:hover {
    background: #1d54d4;
    border-color: #1d54d4;
    box-shadow: 0 4px 14px rgba(37,99,235,0.32);
  }
  .btn.success { color: var(--success); border-color: rgba(47,138,95,0.3); }
  .btn.success:hover { background: var(--success-bg); border-color: var(--success); }
  .btn.danger  { color: var(--danger); border-color: rgba(176,69,69,0.3); }
  .btn.danger:hover  { background: var(--danger-bg); border-color: var(--danger); }

  .notes-area {
    width: 100%;
    min-height: 90px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.55;
    resize: vertical;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .notes-area:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }

  /* Scrollbars */
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb {
    background: var(--line-2);
    border-radius: 5px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  ::-webkit-scrollbar-thumb:hover { background: var(--muted-3); background-clip: padding-box; border: 2px solid transparent; }

  /* Toast */
  .toast {
    position: fixed;
    bottom: 56px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: var(--navy);
    color: #fff;
    padding: 12px 22px;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0;
    pointer-events: none;
    transition: all 0.35s var(--ease-snap);
    z-index: 200;
    box-shadow: var(--shadow-lg);
  }
  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ============================================================
     INSIGHTS — client-side analytics over /api/stats + /api/applications
     ============================================================ */
  .insights-section { margin-bottom: 30px; }
  .insights-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 14px;
  }
  .insight-card {
    grid-column: span 4;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    min-width: 0;
    transition: transform 0.3s var(--ease-out), border-color 0.3s, box-shadow 0.3s;
  }
  .insight-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-2);
    box-shadow: var(--shadow-md);
  }
  .insight-card.span-3 { grid-column: span 3; }
  .insight-card.span-4 { grid-column: span 4; }
  .insight-card.span-5 { grid-column: span 5; }
  .insight-card.span-7 { grid-column: span 7; }
  .insight-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .insight-title {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .insight-note {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--muted-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }
  .insight-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .insight-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 130px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted-3);
    letter-spacing: 0.06em;
    text-align: center;
  }

  /* Funnel */
  .funnel { display: flex; flex-direction: column; gap: 3px; }
  .funnel-row {
    display: grid;
    grid-template-columns: 84px 1fr 80px;
    align-items: center;
    gap: 12px;
  }
  .funnel-row .fl {
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-3);
    text-align: right;
    white-space: nowrap;
  }
  .funnel-row .fv {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .funnel-row .fv .pct {
    color: var(--muted-2);
    font-weight: 400;
    font-size: 10px;
    margin-left: 4px;
  }
  .funnel-track { display: flex; justify-content: center; height: 26px; }
  .funnel-bar {
    height: 100%;
    min-width: 4px;
    border-radius: 5px;
    background: var(--fc, var(--blue));
    opacity: 0.92;
    transform: scaleX(0);
    transition: transform 0.9s var(--ease-cine);
  }
  .chart-anim.in .funnel-bar { transform: scaleX(1); }
  .funnel-conv {
    display: grid;
    grid-template-columns: 84px 1fr 80px;
    gap: 12px;
  }
  .funnel-conv .cv {
    text-align: center;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--muted-2);
    padding: 1px 0 2px;
    font-variant-numeric: tabular-nums;
  }

  /* SVG charts — histogram + timeline */
  .chart-svg { width: 100%; height: auto; display: block; }
  .chart-svg .grid-line { stroke: var(--line); stroke-width: 1; }
  .chart-svg .axis-label {
    font-family: var(--mono);
    font-size: 9.5px;
    fill: var(--muted-3);
    letter-spacing: 0.04em;
  }
  .chart-svg .hist-bars {
    transform-box: fill-box;
    transform-origin: bottom;
    transform: scaleY(0);
    transition: transform 1s var(--ease-cine) 0.1s;
  }
  .chart-anim.in .hist-bars { transform: scaleY(1); }
  .chart-svg .hist-counts { opacity: 0; transition: opacity 0.6s ease 0.95s; }
  .chart-anim.in .hist-counts { opacity: 1; }
  .chart-svg .tl-line {
    fill: none;
    stroke: var(--teal);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    transition: stroke-dashoffset 1.5s var(--ease-cine) 0.15s;
  }
  .chart-anim.in .tl-line { stroke-dashoffset: 0; }
  .chart-svg .tl-fill { opacity: 0; transition: opacity 0.8s ease 0.9s; }
  .chart-anim.in .tl-fill { opacity: 1; }
  .chart-svg .tl-dot {
    fill: var(--surface);
    stroke: var(--teal);
    stroke-width: 1.6;
    opacity: 0;
    transition: opacity 0.5s ease 1.1s;
  }
  .chart-anim.in .tl-dot { opacity: 1; }

  /* Donut */
  .donut-wrap { display: flex; align-items: center; gap: 14px; }
  .donut {
    width: 116px; height: 116px; flex-shrink: 0;
    opacity: 0;
    transform: rotate(-16deg) scale(0.95);
    transition: opacity 0.7s ease 0.1s, transform 0.9s var(--ease-cine) 0.1s;
  }
  .chart-anim.in .donut { opacity: 1; transform: none; }
  .donut svg { width: 100%; height: 100%; display: block; }
  .donut .donut-num {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 26px;
    fill: var(--navy);
    letter-spacing: -0.02em;
  }
  .donut .donut-sub {
    font-family: var(--mono);
    font-size: 8.5px;
    fill: var(--muted-2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .donut-legend { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .legend-row {
    display: flex; align-items: center; gap: 8px;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.5s ease, transform 0.5s var(--ease-out);
  }
  .chart-anim.in .legend-row { opacity: 1; transform: none; }
  .legend-dot { width: 8px; height: 8px; border-radius: 2.5px; flex-shrink: 0; }
  .legend-name {
    flex: 1; min-width: 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .legend-val {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .legend-val .lp { color: var(--muted-2); font-weight: 400; margin-left: 4px; }

  /* Horizontal mix bars — archetypes */
  .hbar-list { display: flex; flex-direction: column; gap: 9px; }
  .hbar {
    display: grid;
    grid-template-columns: 118px 1fr 36px;
    align-items: center;
    gap: 10px;
  }
  .hbar .hl {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--ink-3);
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hbar .ht {
    height: 8px;
    background: var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .hbar .hf {
    height: 100%;
    border-radius: 4px;
    background: var(--hc, var(--blue));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s var(--ease-cine);
  }
  .chart-anim.in .hbar .hf { transform: scaleX(1); }
  .hbar .hn {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* ============================================================
     ADVANCED CONTROLS — sort + facet filters above the table
     ============================================================ */
  .controls-advanced {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
  }
  .ctl-group { display: flex; align-items: center; gap: 8px; }
  .ctl-label {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 500;
    white-space: nowrap;
  }
  .ctl-select {
    appearance: none;
    -webkit-appearance: none;
    background-color: var(--surface-2);
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%235b6a87' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 10px center;
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 7px 28px 7px 10px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    outline: none;
    max-width: 190px;
    transition: border-color 0.2s, box-shadow 0.2s, color 0.2s;
  }
  .ctl-select:hover { border-color: var(--line-3); }
  .ctl-select:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(37,99,235,0.12); }
  .ctl-select.is-active { border-color: rgba(37,99,235,0.45); color: var(--blue); }
  .ctl-divider { width: 1px; height: 22px; background: var(--line); }
  .seg {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 7px;
  }
  .seg button {
    border: none;
    background: transparent;
    padding: 5px 10px;
    border-radius: 5px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
    transition: background 0.2s, color 0.2s;
  }
  .seg button:hover:not(.active) { color: var(--ink-2); background: var(--surface-3); }
  .seg button.active { background: var(--navy); color: #fff; }
  .ctl-reset {
    margin-left: auto;
    border: none;
    background: transparent;
    color: var(--blue);
    font-family: var(--sans);
    font-size: 11.5px;
    font-weight: 600;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 6px;
    transition: background 0.2s;
  }
  .ctl-reset:hover { background: var(--info-bg); }
  .ctl-reset[hidden] { display: none; }

  /* ============================================================
     SKELETON LOADING + EMPTY STATES
     ============================================================ */
  .skeleton {
    position: relative;
    overflow: hidden;
    background: var(--surface-3);
    border-radius: 6px;
  }
  .skeleton::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
    transform: translateX(-100%);
    animation: shimmer 1.6s ease infinite;
  }
  @keyframes shimmer { 100% { transform: translateX(100%); } }
  .skel-block { height: 12px; }
  .skel-row td { padding: 14px 18px; }
  .skel-row:nth-child(2) .skeleton::after { animation-delay: 0.12s; }
  .skel-row:nth-child(3) .skeleton::after { animation-delay: 0.24s; }
  .skel-row:nth-child(4) .skeleton::after { animation-delay: 0.36s; }
  .skel-row:nth-child(5) .skeleton::after { animation-delay: 0.48s; }

  .empty-glyph {
    width: 44px; height: 44px;
    margin: 0 auto 18px;
    position: relative;
    border-radius: 50%;
    border: 1.5px solid var(--line-3);
  }
  .empty-glyph::before {
    content: "";
    position: absolute; inset: -1.5px;
    border-radius: 50%;
    border: 1.5px solid var(--blue);
    animation: empty-ping 2.4s var(--ease-out) infinite;
  }
  .empty-glyph::after {
    content: "";
    position: absolute;
    left: 50%; top: 50%;
    width: 8px; height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--blue);
  }
  @keyframes empty-ping {
    0%       { transform: scale(0.55); opacity: 0.8; }
    75%,100% { transform: scale(1.8);  opacity: 0; }
  }
  .empty .empty-clear { margin-top: 18px; display: inline-block; width: auto; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Responsive */
  @media (max-width: 1280px) {
    .pipeline { grid-template-columns: repeat(5, 1fr); }
    .insight-card.span-3,
    .insight-card.span-4,
    .insight-card.span-5,
    .insight-card.span-7 { grid-column: span 6; }
  }
  @media (max-width: 960px) {
    .app { padding: 22px 22px 100px; }
    .page-title { font-size: 28px; }
    .page-header { flex-direction: column; align-items: stretch; }
    .page-rail { text-align: left; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .pipeline { grid-template-columns: repeat(3, 1fr); }
    .drawer-inner { padding: 30px 22px 100px; }
    .drawer-title { font-size: 22px; }
    .hide-md { display: none; }
    .insight-card.span-3,
    .insight-card.span-4,
    .insight-card.span-5,
    .insight-card.span-7 { grid-column: 1 / -1; }
    .ctl-reset { margin-left: 0; }
  }
  @media (max-width: 640px) {
    .hide-sm { display: none; }
    .stats-grid { grid-template-columns: 1fr 1fr; }
    .drawer-actions { grid-template-columns: 1fr; }
    .btn.primary { grid-column: 1; }
    .stat-value { font-size: 32px; }
    .topbar-meta .meta-chip:not(:last-child) { display: none; }
    .brand-logo { height: 60px; }
    .topbar { height: 80px; }
  }
</style>
</head>
