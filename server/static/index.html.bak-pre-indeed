<script>
  // ============================================================
  // EMPTY-STATE STUB — dashboard reads only real DB state.
  // When the scheduler hasn't found any jobs yet, this neutral zero shape
  // is rendered instead of design mockups.
  // ============================================================
  const EMPTY_STATS = {
    total_jobs: 0, jobs_today: 0, jobs_this_week: 0,
    pipeline: {
      found: 0, scored: 0, queued: 0, materials_ready: 0,
      approved: 0, applied: 0, response_received: 0, interview: 0,
      rejected: 0, no_response: 0, skipped: 0,
    },
    avg_score: 0, high_matches: 0, needs_followup: 0, response_rate: 0,
    auto_applied_total: 0, auto_applied_today: 0,
    last_update: new Date().toISOString(),
  };

  // ============================================================
  // STATE & HELPERS
  // ============================================================
  const state = {
    applications: [], stats: null, filter: "all", search: "", selectedId: null,
    sort: "score_desc", archFilter: "all", srcFilter: "all", minScore: 0,
  };
  const $ = (id) => document.getElementById(id);
  const $$ = (sel) => document.querySelectorAll(sel);

  const fmtTimeAgo = (h) => h == null ? "—" : h < 1 ? "< 1 hr" : h < 24 ? `${h} hr` : `${Math.floor(h/24)} day${Math.floor(h/24)===1?'':'s'}`;
  const fmtDateTime = (iso) => !iso ? "—" : new Date(iso).toLocaleDateString("en-US",{month:"short",day:"numeric"}) + " · " + new Date(iso).toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"});
  const scoreClass = (s) => s == null ? "unscored" : s >= 80 ? "high" : s >= 60 ? "mid" : "low";
  const escapeHtml = (s) => s == null ? "" : String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");

  function renderTodayDate() {
    const d = new Date();
    const month = d.toLocaleDateString("en-US",{month:"short"}).toUpperCase();
    $("today-eyebrow").textContent = `DASHBOARD · ${month} ${d.getDate()} · ${d.getFullYear()}`;
  }
  function renderSessionTime() {
    $("session-time").textContent = new Date().toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"});
  }

  function animateValue(el, endValue, duration = 1100, suffix = "") {
    const startValue = parseFloat(el.dataset.current || "0");
    const start = performance.now();
    const isInt = Number.isInteger(endValue);
    function tick(now) {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 4);
      const current = startValue + (endValue - startValue) * eased;
      if (suffix) el.innerHTML = (isInt ? Math.round(current) : current.toFixed(1)) + `<span class="suffix">${suffix}</span>`;
      else el.textContent = isInt ? Math.round(current) : current.toFixed(1);
      if (t < 1) requestAnimationFrame(tick);
      else el.dataset.current = endValue;
    }
    requestAnimationFrame(tick);
  }

  // Sparkline
  function generateSpark(key, points = 18) {
    const seeds = {
      total: { base: 180, drift: 40 }, today: { base: 5, drift: 10 },
      applied: { base: 10, drift: 14 }, interviews: { base: 0, drift: 3 },
      avg: { base: 70, drift: 14 }, response: { base: 25, drift: 20 },
      followup: { base: 1, drift: 4 }, high: { base: 18, drift: 14 },
    };
    const cfg = seeds[key] || { base: 40, drift: 20 };
    const vals = [];
    let cur = cfg.base + Math.random() * cfg.drift * 0.3;
    for (let i = 0; i < points; i++) {
      cur += (Math.random() - 0.42) * cfg.drift * 0.4;
      cur = Math.max(cfg.base - cfg.drift * 0.5, Math.min(cfg.base + cfg.drift, cur));
      vals.push(cur);
    }
    for (let i = points - 5; i < points; i++) vals[i] += (i - (points - 5)) * 1.4;
    const min = Math.min(...vals), max = Math.max(...vals);
    const range = max - min || 1;
    const w = 100, h = 26, step = w / (points - 1);
    const pts = vals.map((v, i) => [i * step, h - ((v - min) / range) * (h - 4) - 2]);
    const linePath = "M " + pts.map(p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" L ");
    const fillPath = linePath + ` L ${w} ${h} L 0 ${h} Z`;
    return { linePath, fillPath };
  }

  function renderSparks() {
    $$(".spark").forEach(svg => {
      const key = svg.dataset.spark;
      const color = svg.dataset.color || "#2563eb";
      const { linePath, fillPath } = generateSpark(key);
      svg.innerHTML = `
        <defs>
          <linearGradient id="sg-${key}" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="${color}" stop-opacity="0.22"/>
            <stop offset="100%" stop-color="${color}" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path class="fill" d="${fillPath}" fill="url(#sg-${key})"/>
        <path class="line" d="${linePath}" stroke="${color}"/>
      `;
    });
  }

  // ============================================================
  // RENDERING
  // ============================================================
  function renderStats(stats) {
    if (!stats) return;
    state.stats = stats;
    animateValue($("stat-total"), stats.total_jobs);
    animateValue($("stat-today"), stats.jobs_today);
    animateValue($("stat-applied"), stats.pipeline.applied || 0);
    animateValue($("stat-interviews"), stats.pipeline.interview || 0);
    animateValue($("stat-avg-score"), stats.avg_score);
    animateValue($("stat-response-rate"), stats.response_rate, 1100, "%");
    animateValue($("stat-autoapply"), stats.auto_applied_today || 0);
    animateValue($("stat-high"), stats.high_matches);

    $("stat-total-delta").textContent    = `+${stats.jobs_this_week} this week`;
    $("stat-applied-delta").textContent  = `${stats.pipeline.approved || 0} ready`;
    const autoCap = $("stat-autoapply-caption");
    if (autoCap) {
      const total = stats.auto_applied_total || 0;
      autoCap.textContent = total > 0 ? `${total} total · ⚡ via bot` : "scheduler will submit ≥75 fits";
    }
    renderPipeline(stats.pipeline);
    renderFilterCounts(stats.pipeline);
  }

  function renderPipeline(pipeline) {
    const stages = [
      { key: "found",           label: "Found",     stage: 1 },
      { key: "scored",          label: "Scored",    stage: 2 },
      { key: "queued",          label: "Queued",    stage: 3 },
      { key: "materials_ready", label: "Materials", stage: 4 },
      { key: "approved",        label: "Approved",  stage: 5 },
      { key: "applied",         label: "Applied",   stage: 6, warning: true },
      { key: "interview",       label: "Interview", stage: 7, success: true },
      { key: "rejected",        label: "Rejected",  stage: 8, danger: true },
      { key: "skipped",         label: "Skipped",   stage: 9 },
    ];
    const total = Math.max(...stages.map(s => pipeline[s.key] || 0), 1);
    const strip = $("pipeline-strip");

    const html = stages.map((s) => {
      const n = pipeline[s.key] || 0;
      const pct = Math.min(1, n / total);
      const classes = [
        "pipe-node",
        s.warning ? "warning" : "",
        s.success ? "success" : "",
        s.danger ? "danger" : "",
        state.filter === s.key ? "active" : "",
      ].filter(Boolean).join(" ");
      return `
        <button class="${classes}" data-filter="${s.key}" style="--bar-pct:${pct}">
          <div class="pipe-stage">STAGE ${String(s.stage).padStart(2, "0")}</div>
          <div class="pipe-label">${s.label}</div>
          <div class="pipe-count" data-target="${n}">0</div>
          <div class="bar-track"><div class="bar-fill"></div></div>
        </button>
      `;
    }).join("");

    strip.innerHTML = html;

    strip.querySelectorAll(".pipe-count").forEach(el => {
      const target = parseInt(el.dataset.target, 10);
      animateValue(el, target, 1000);
    });
    strip.querySelectorAll(".pipe-node").forEach(btn => {
      btn.addEventListener("click", () => setFilter(btn.dataset.filter));
    });
  }

  function renderFilterCounts(pipeline) {
    const activeCount = (pipeline.materials_ready||0)+(pipeline.queued||0)+(pipeline.approved||0)+(pipeline.applied||0)+(pipeline.scored||0)+(pipeline.interview||0);
    const appliedCount = (pipeline.applied||0)+(pipeline.interview||0)+(pipeline.response_received||0)+(pipeline.rejected||0)+(pipeline.no_response||0);
    $("cnt-all").textContent = state.applications.length;
    $("cnt-active").textContent = activeCount;
    $("cnt-ready").textContent = pipeline.materials_ready || 0;
    $("cnt-queued").textContent = pipeline.queued || 0;
    $("cnt-applied").textContent = appliedCount;
    $("cnt-interview").textContent = pipeline.interview || 0;
    $("cnt-rejected").textContent = pipeline.rejected || 0;
  }

  const srcKey = (a) => a.source ? a.source.split(":")[0] : "unknown";

  const SORTERS = {
    score_desc:   (a, b) => (b.fit_score ?? -1) - (a.fit_score ?? -1),
    score_asc:    (a, b) => (a.fit_score ?? 101) - (b.fit_score ?? 101),
    date_desc:    (a, b) => new Date(b.date_found || 0) - new Date(a.date_found || 0),
    date_asc:     (a, b) => new Date(a.date_found || 0) - new Date(b.date_found || 0),
    company_asc:  (a, b) => (a.company || "").localeCompare(b.company || "", undefined, { sensitivity: "base" }),
    company_desc: (a, b) => (b.company || "").localeCompare(a.company || "", undefined, { sensitivity: "base" }),
  };

  function renderTable(apps) {
    const body = $("app-table-body");
    const filtered = apps.filter(a => {
      if (state.filter === "active") {
        if (!["materials_ready","queued","approved","applied","scored","interview"].includes(a.status)) return false;
      } else if (state.filter === "applied") {
        if (!["applied","interview","response_received","rejected","no_response"].includes(a.status)) return false;
      } else if (state.filter !== "all") {
        if (a.status !== state.filter) return false;
      }
      if (state.archFilter !== "all") {
        if (state.archFilter === "__none__") { if (a.archetype_label) return false; }
        else if (a.archetype_label !== state.archFilter) return false;
      }
      if (state.srcFilter !== "all" && srcKey(a) !== state.srcFilter) return false;
      if (state.minScore > 0 && (a.fit_score == null || a.fit_score < state.minScore)) return false;
      if (state.search) {
        const q = state.search.toLowerCase();
        if (!(`${a.title} ${a.company} ${a.location}`).toLowerCase().includes(q)) return false;
      }
      return true;
    });

    filtered.sort(SORTERS[state.sort] || SORTERS.score_desc);

    $("result-num").textContent = filtered.length;

    if (filtered.length === 0) {
      if (apps.length === 0) {
        body.innerHTML = `<tr><td colspan="8" class="empty"><div class="empty-glyph"></div><h2>No jobs yet</h2><p>The scanner is searching — new roles will land here automatically.</p></td></tr>`;
      } else {
        body.innerHTML = `<tr><td colspan="8" class="empty"><div class="empty-glyph"></div><h2>No matches</h2><p>Nothing fits the current view. Loosen a filter, or wait for the next scan.</p><button class="btn empty-clear" onclick="resetFilters()">Clear all filters</button></td></tr>`;
      }
      return;
    }

    body.innerHTML = filtered.map((a, i) => {
      const sc = a.fit_score;
      const scCls = scoreClass(sc);
      const scDisp = sc == null ? "—" : sc;
      const statusMeta = a.status_meta || { label: a.status, tone: "neutral" };
      const ageDisp = fmtTimeAgo(a.age_hours);
      const ageFresh = a.age_hours != null && a.age_hours < 12;
      const srcLabel = a.source ? a.source.split(":")[0] : "—";
      const selected = state.selectedId === a.id ? "selected" : "";

      const r = 19, circ = 2 * Math.PI * r;
      const pct = sc == null ? 0 : sc / 100;
      const offset = circ * (1 - pct);
      const ringHtml = sc == null ? "" : `
        <svg viewBox="0 0 44 44">
          <circle class="bg" cx="22" cy="22" r="${r}"/>
          <circle class="fg" cx="22" cy="22" r="${r}"
            stroke-dasharray="${circ.toFixed(1)}"
            stroke-dashoffset="${offset.toFixed(1)}"/>
        </svg>
      `;

      return `
        <tr class="${selected}" data-id="${a.id}" style="animation-delay: ${Math.min(i, 24) * 28 + 100}ms">
          <td class="cell-score">
            <div class="score-chip ${scCls}">
              ${ringHtml}
              <span class="score-num">${scDisp}</span>
            </div>
          </td>
          <td class="cell-company">${escapeHtml(a.company)}</td>
          <td class="cell-title">${escapeHtml(a.title)}</td>
          <td class="cell-location hide-sm">${escapeHtml(a.location || "—")}</td>
          <td class="cell-source hide-md">${escapeHtml(srcLabel)}</td>
          <td class="cell-age hide-md ${ageFresh ? 'fresh' : ''}">${ageDisp}</td>
          <td class="col-status"><span class="status ${statusMeta.tone}">${escapeHtml(statusMeta.label)}</span></td>
          <td>
            <div class="asset-indicators">
              <span class="asset ${a.has_tailored_cv ? 'active' : ''}">CV</span>
              <span class="asset ${a.has_cover_letter ? 'active' : ''}">CL</span>
              ${a.auto_applied ? '<span class="asset bot" title="Submitted by bot">⚡</span>' : ''}
            </div>
          </td>
        </tr>
      `;
    }).join("");

    body.querySelectorAll("tr[data-id]").forEach(row => {
      row.addEventListener("click", () => openDrawer(parseInt(row.dataset.id)));
    });
  }

  function renderTicker(activity) {
    if (!activity || activity.length === 0) return;
    const track = $("ticker-track");
    const tagClass = (a) => (a.action || "").toLowerCase();
    const items = activity.map(a => `
      <span class="ticker-item">
        <span class="tick-tag ${tagClass(a)}">${a.action || "UPDATE"}</span>
        <span class="tick-company">${escapeHtml(a.company)}</span>
        <span>${escapeHtml(a.title)}</span>
        <span class="tick-sep">—</span>
        <span class="tick-time">${fmtDateTime(a.timestamp)}</span>
      </span>
    `).join("");
    track.innerHTML = items + items;
  }

  // ============================================================
  // DRAWER
  // ============================================================
  function openDrawer(appId) {
    state.selectedId = appId;
    const app = state.applications.find(a => a.id === appId);
    if (!app) return;
    renderTable(state.applications);

    const statusMeta = app.status_meta || { label: app.status, tone: "neutral" };
    const sc = app.fit_score;
    const r = 40, circ = 2 * Math.PI * r;
    const pct = sc == null ? 0 : sc / 100;
    const offset = circ * (1 - pct);
    const ringStroke = sc >= 80 ? "var(--success)" : sc >= 60 ? "var(--warning)" : "var(--muted-2)";

    // Archetype + threshold + dimensions — borrowed from career-ops scoring model
    const archLabel = app.archetype_label || "";
    const archKey   = app.archetype || "";
    const archConf  = app.archetype_confidence;
    const archMin   = (state.archetypeFloors || {})[archKey];  // populated by loadArchetypes()
    const belowThreshold = (sc != null && archMin != null && sc < archMin);

    $("drawer-content").innerHTML = `
      <button class="drawer-close" onclick="closeDrawer()" aria-label="Close">✕</button>

      <div class="drawer-company">
        <span>${escapeHtml(app.company)}</span>
        <span class="src">${escapeHtml(app.source || "")}</span>
        ${archLabel ? `<span class="archetype-badge">${escapeHtml(archLabel)}${archConf != null ? `<span class="conf">${(archConf*100|0)}%</span>` : ""}</span>` : ""}
      </div>
      <h2 class="drawer-title">${escapeHtml(app.title)}</h2>

      ${belowThreshold ? `
      <div class="threshold-banner">
        <span class="glyph">⚠</span>
        <span>Below recommended auto-apply threshold for <strong>${escapeHtml(archLabel || "this archetype")}</strong> (${archMin}). The bot will <strong>not</strong> auto-submit this one.</span>
      </div>` : ""}

      ${app.auto_applied ? `
      <div class="auto-apply-banner">
        <span class="glyph">⚡</span>
