      <div class="stat-footer">
        <div class="stat-caption">applied → replied</div>
        <svg class="spark" viewBox="0 0 100 26" preserveAspectRatio="none" data-spark="response" data-color="#2ea7a0"></svg>
      </div>
    </div>

    <div class="stat blue">
      <div class="stat-header">
        <div class="stat-label">Auto-Applied</div>
