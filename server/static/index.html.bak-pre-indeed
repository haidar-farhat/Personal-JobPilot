        <div class="stat-delta-chip" id="stat-avg-delta">/ 100</div>
      </div>
      <div class="stat-value" id="stat-avg-score">0</div>
      <div class="stat-footer">
        <div class="stat-caption">across 156 scored</div>
        <svg class="spark" viewBox="0 0 100 26" preserveAspectRatio="none" data-spark="avg" data-color="#2563eb"></svg>
      </div>
    </div>

    <div class="stat teal">
      <div class="stat-header">
        <div class="stat-label">Response Rate</div>
        <div class="stat-delta-chip up" id="stat-response-delta">strong</div>
      </div>
