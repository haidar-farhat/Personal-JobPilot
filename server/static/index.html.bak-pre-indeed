  // ============================================================
  // DATA LOAD
  // ============================================================
  async function fetchJSON(url) {
    try {
      const res = await fetch(url, { cache: "no-store" });
      if (!res.ok) return null;
      return await res.json();
    } catch { return null; }
  }

  async function loadData() {
    const [stats, apps, activity] = await Promise.all([
      fetchJSON("/api/stats"),
      fetchJSON("/api/applications?limit=500"),
      fetchJSON("/api/activity?limit=20"),
    ]);
    // No sample-data fallback — render real state only.
    const finalStats    = stats    || EMPTY_STATS;
    const finalApps     = apps     || [];
    const finalActivity = activity || [];
    state.applications = finalApps;
    renderStats(finalStats);
    syncFilterOptions(finalApps);
    renderTable(finalApps);
    renderInsights();
    renderTicker(finalActivity.length ? finalActivity : [{
      action: "IDLE", company: "Scheduler",
      title: "Waiting for first scan…",
      source: "system", timestamp: new Date().toISOString(),
    }]);
  }

  function connectSSE() {
    try {
      const evtSource = new EventSource("/api/stream");
      evtSource.onmessage = (e) => {
        try {
          const msg = JSON.parse(e.data);
          if (msg.type === "stats") {
            renderStats(msg.payload);
            $("last-sync").textContent = "just now";
            $("live-label").textContent = "Live";
          } else if (msg.type === "applications") {
            state.applications = msg.payload;
            syncFilterOptions(msg.payload);
            renderTable(msg.payload);
            renderInsights();
          } else if (msg.type === "activity") {
            renderTicker(msg.payload);
          }
        } catch {}
      };
      evtSource.onerror = () => evtSource.close();
    } catch {}
  }

  // ============================================================
  // ARCHETYPE / DIMENSION / EVALUATION HELPERS
  // ============================================================
  // Borrowed from career-ops's archetype-routed multi-dim scoring.

  // Pretty label for each dimension key
  const DIM_LABELS = {
    technical_fit:       "Technical fit",
    level_match:         "Level match",
    comp_range:          "Comp range",
    location_remote:     "Location",
    archetype_fit:       "Archetype fit",
    skills_overlap:      "Skills overlap",
    growth_signal:       "Growth",
    company_reputation:  "Reputation",
    ats_keyword_density: "ATS density",
    gap_severity:        "Gap (inv.)",
  };
  // Display order — most-impactful dims first
  const DIM_ORDER = [
    "technical_fit", "level_match", "archetype_fit", "skills_overlap",
    "gap_severity", "ats_keyword_density", "location_remote", "comp_range",
    "company_reputation", "growth_signal",
  ];

  function renderDimensionRows(dims, weights) {
    if (!dims) return "";
    const order = DIM_ORDER.filter(k => k in dims);
    return order.map(key => {
      const v = dims[key] ?? 0;
      const cls = v >= 75 ? "high" : v >= 50 ? "mid" : "low";
      const w = weights && weights[key] != null ? `<span class="w">×${(weights[key]*100).toFixed(0)}%</span>` : "";
      const label = DIM_LABELS[key] || key;
      return `<div class="dim-row ${cls}">
        <div class="label">${escapeHtml(label)}${w}</div>
        <div class="bar"><div class="fill" style="width:${v}%"></div></div>
        <div class="num">${v}</div>
      </div>`;
    }).join("");
  }

  // Tiny markdown renderer — handles ###, **bold**, lists, hr, paragraphs
  function renderMarkdown(md) {
    if (!md) return "";
    const escaped = md.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
    let out = [];
    const lines = escaped.split(/\r?\n/);
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      // headings
      const h3m = line.match(/^###\s+(.+)$/);
      if (h3m) { out.push(`<h3>${h3m[1]}</h3>`); i++; continue; }
      const h2m = line.match(/^##\s+(.+)$/);
      if (h2m) { out.push(`<h2>${h2m[1]}</h2>`); i++; continue; }
      const h1m = line.match(/^#\s+(.+)$/);
      if (h1m) { out.push(`<h1>${h1m[1]}</h1>`); i++; continue; }
      // hr
      if (/^---+$/.test(line.trim())) { out.push("<hr/>"); i++; continue; }
      // bullet list
      if (/^[-*]\s+/.test(line)) {
        let items = [];
        while (i < lines.length && /^[-*]\s+/.test(lines[i])) {
          items.push(`<li>${lines[i].replace(/^[-*]\s+/, "")}</li>`);
          i++;
        }
        out.push(`<ul>${items.join("")}</ul>`);
        continue;
      }
      // blank
      if (line.trim() === "") { i++; continue; }
      // paragraph (consume until blank)
      let buf = [line];
      i++;
      while (i < lines.length && lines[i].trim() !== "" && !/^[-*]\s+/.test(lines[i]) && !/^#/.test(lines[i])) {
        buf.push(lines[i]); i++;
      }
      out.push(`<p>${buf.join(" ")}</p>`);
    }
    let html = out.join("\n");
    // bold + inline code (run AFTER block parsing to preserve them inside lists/paragraphs)
    html = html.replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>");
    html = html.replace(/`([^`]+)`/g, "<code>$1</code>");
    return html;
  }

  async function toggleEvaluation(appId) {
    const panel = document.getElementById(`eval-panel-${appId}`);
    const body  = document.getElementById(`eval-body-${appId}`);
    if (!panel) return;

    const isOpen = panel.classList.contains("open");
    panel.classList.toggle("open");
    if (isOpen) return;  // closing — nothing else to do

    // Load on first open
    if (body && body.dataset.loaded !== "1") {
      body.innerHTML = '<div class="eval-loading">Loading evaluation…</div>';
      try {
        const data = await fetchJSON(`/api/application/${appId}/evaluation`);
        if (data && data.markdown) {
          body.innerHTML = renderMarkdown(data.markdown);
          body.dataset.loaded = "1";
        } else {
          body.innerHTML = '<div class="eval-loading">No evaluation report on disk yet — wait for the next ranking cycle.</div>';
        }
      } catch (e) {
        body.innerHTML = `<div class="eval-loading">Could not load evaluation.</div>`;
      }
    }
  }

  async function loadArchetypes() {
    const data = await fetchJSON("/api/archetypes");
    if (!data || !data.archetypes) return;
    const floors = {};
    for (const [key, info] of Object.entries(data.archetypes)) {
      floors[key] = info.auto_apply_min_score;
    }
    state.archetypeFloors = floors;
  }

  // ============================================================
  // INSIGHTS — all analytics computed client-side from the
  // already-loaded /api/stats + /api/applications payloads.
  // Hand-built SVG/CSS charts — no chart library.
  // ============================================================
  const INSIGHT_SERIES = ["var(--blue)", "var(--teal)", "var(--steel)", "var(--cyan-soft)", "var(--navy)", "var(--warning)"];

  function insightEmpty(msg) {
    return `<div class="insight-empty">${escapeHtml(msg || "No data yet — scanner is searching…")}</div>`;
  }

  // Re-trigger the CSS entrance transitions on freshly rendered chart markup
  function animateChart(bodyEl) {
    const wrap = bodyEl.querySelector(".chart-anim");
    if (!wrap) return;
    requestAnimationFrame(() => requestAnimationFrame(() => wrap.classList.add("in")));
  }

  function renderFunnel(apps) {
    const body = $("funnel-body");
    if (!body) return;
    if (!apps.length) { body.innerHTML = insightEmpty(); return; }

    const appliedStatuses = ["applied", "response_received", "interview", "rejected", "no_response"];
    const found     = apps.length;
    const scored    = apps.filter(a => a.fit_score != null).length;
    const materials = apps.filter(a => a.has_tailored_cv || a.has_cover_letter
                        || ["materials_ready", "approved", ...appliedStatuses].includes(a.status)).length;
    const applied   = apps.filter(a => appliedStatuses.includes(a.status) || a.date_applied).length;
    const interview = apps.filter(a => a.status === "interview").length;

    const stages = [
      { label: "Found",     n: found,     c: "var(--navy)" },
      { label: "Scored",    n: scored,    c: "var(--steel)" },
      { label: "Materials", n: materials, c: "var(--blue)" },
      { label: "Applied",   n: applied,   c: "var(--teal)" },
      { label: "Interview", n: interview, c: "var(--success)" },
    ];
    const max = Math.max(stages[0].n, 1);

    let html = "";
    stages.forEach((s, i) => {
      if (i > 0) {
        const prev = stages[i - 1].n;
        const conv = prev > 0 ? Math.round((s.n / prev) * 100) : null;
        html += `<div class="funnel-conv"><span></span><span class="cv">▾ ${conv == null ? "—" : conv + "%"}</span><span></span></div>`;
      }
      const widthPct = Math.max((s.n / max) * 100, s.n > 0 ? 4 : 2);
      const share = found ? Math.round((s.n / found) * 100) : 0;
      html += `<div class="funnel-row">
        <div class="fl">${s.label}</div>
        <div class="funnel-track"><div class="funnel-bar" style="width:${widthPct.toFixed(1)}%; --fc:${s.c}; transition-delay:${i * 90}ms" title="${s.label}: ${s.n}"></div></div>
        <div class="fv">${s.n}<span class="pct">${share}%</span></div>
      </div>`;
    });

    body.innerHTML = `<div class="chart-anim funnel">${html}</div>`;
    const note = $("funnel-note");
    if (note) note.textContent = `${found ? Math.round((applied / found) * 100) : 0}% found → applied`;
    animateChart(body);
  }

  function renderHistogram(apps) {
    const body = $("hist-body");
    if (!body) return;
    const scores = apps.map(a => a.fit_score).filter(s => typeof s === "number" && !isNaN(s));
    if (!scores.length) {
      body.innerHTML = insightEmpty("No scored jobs yet");
      const n0 = $("hist-note"); if (n0) n0.textContent = "awaiting scores";
      return;
    }

    const buckets = new Array(10).fill(0);
    scores.forEach(s => buckets[Math.min(9, Math.max(0, Math.floor(s / 10)))]++);
    const maxN = Math.max(...buckets, 1);

    const W = 760, H = 230, padL = 34, padR = 14, padT = 22, padB = 26;
    const plotW = W - padL - padR, plotH = H - padT - padB, baseY = H - padB;
    const cw = plotW / 10;
    const xAt = i => padL + i * cw;
    const sx = score => padL + (score / 100) * plotW;
    const yAt = n => padT + (1 - n / maxN) * plotH;

    // Auto-apply threshold band from archetype floors (fallback 75)
    const floors = Object.values(state.archetypeFloors || {}).filter(v => typeof v === "number");
    const thr = floors.length ? Math.min(...floors) : 75;
    const thrHi = floors.length ? Math.max(...floors) : thr;

    let grid = "";
    [...new Set([0, Math.ceil(maxN / 2), maxN])].forEach(n => {
      const gy = yAt(n);
      grid += `<line class="grid-line" x1="${padL}" y1="${gy.toFixed(1)}" x2="${W - padR}" y2="${gy.toFixed(1)}"/>
        <text class="axis-label" x="${padL - 7}" y="${(gy + 3).toFixed(1)}" text-anchor="end">${n}</text>`;
    });

    const bandX = sx(thr);
    const bandLabel = floors.length && thrHi !== thr ? `AUTO-APPLY FLOORS ${thr}–${thrHi}` : `AUTO-APPLY ≥ ${thr}`;
    const band = `
      <rect x="${bandX.toFixed(1)}" y="${padT}" width="${(W - padR - bandX).toFixed(1)}" height="${plotH}" fill="rgba(46,167,160,0.07)"/>
      <line x1="${bandX.toFixed(1)}" y1="${padT}" x2="${bandX.toFixed(1)}" y2="${baseY}" stroke="var(--teal)" stroke-width="1" stroke-dasharray="3 3" opacity="0.75"/>
      <text class="axis-label" x="${(bandX + 7).toFixed(1)}" y="${padT - 8}" style="fill:var(--teal)">${bandLabel}</text>`;

    let bars = "", countLabels = "";
    buckets.forEach((n, i) => {
      if (n === 0) return;
      const bx = xAt(i) + 4, bw = cw - 8;
      const bh = Math.max(baseY - yAt(n), 2);
      const by = baseY - bh;
      const inZone = (i * 10 + 10) > thr;
      bars += `<rect x="${bx.toFixed(1)}" y="${by.toFixed(1)}" width="${bw.toFixed(1)}" height="${bh.toFixed(1)}" rx="3"
        fill="${inZone ? "var(--teal)" : "var(--steel)"}" opacity="${inZone ? 0.9 : 0.55}">
        <title>${i * 10}–${i === 9 ? 100 : i * 10 + 9}: ${n} job${n === 1 ? "" : "s"}</title></rect>`;
      countLabels += `<text class="axis-label" x="${(bx + bw / 2).toFixed(1)}" y="${(by - 5).toFixed(1)}" text-anchor="middle">${n}</text>`;
    });

    let ticks = "";
    [0, 20, 40, 60, 80, 100].forEach(v => {
      ticks += `<text class="axis-label" x="${sx(v).toFixed(1)}" y="${baseY + 15}" text-anchor="middle">${v}</text>`;
    });

    body.innerHTML = `<div class="chart-anim">
      <svg class="chart-svg" viewBox="0 0 ${W} ${H}" role="img" aria-label="Fit score distribution">
        ${grid}${band}
        <line x1="${padL}" y1="${baseY}" x2="${W - padR}" y2="${baseY}" stroke="var(--line-2)" stroke-width="1"/>
        <g class="hist-bars">${bars}</g>
        <g class="hist-counts">${countLabels}</g>
        ${ticks}
      </svg></div>`;

    const sorted = [...scores].sort((a, b) => a - b);
    const median = sorted[Math.floor(sorted.length / 2)];
    const note = $("hist-note");
    if (note) note.textContent = `${scores.length} scored · median ${median}`;
    animateChart(body);
  }

  function renderTimeline(apps) {
    const body = $("timeline-body");
    if (!body) return;
    if (!apps.length) { body.innerHTML = insightEmpty(); return; }

    const DAYS = 14;
    const today = new Date();
    const dayKey = d => `${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;
    const days = [];
    const counts = new Map();
    for (let i = DAYS - 1; i >= 0; i--) {
      const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() - i);
      days.push(d);
      counts.set(dayKey(d), 0);
    }
    apps.forEach(a => {
      if (!a.date_found) return;
      const d = new Date(a.date_found);
      if (isNaN(d)) return;
      const k = dayKey(d);
      if (counts.has(k)) counts.set(k, counts.get(k) + 1);
    });

    const vals = days.map(d => counts.get(dayKey(d)));
    const total = vals.reduce((s, v) => s + v, 0);
    const maxN = Math.max(...vals, 1);

    const W = 520, H = 190, padL = 30, padR = 14, padT = 18, padB = 26;
    const plotW = W - padL - padR, plotH = H - padT - padB, baseY = H - padB;
    const px = i => padL + (i / (DAYS - 1)) * plotW;
    const py = n => padT + (1 - n / maxN) * plotH;

    const pts = vals.map((v, i) => [px(i), py(v)]);
    const line = "M " + pts.map(p => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" L ");
    const area = `${line} L ${px(DAYS - 1).toFixed(1)} ${baseY} L ${padL} ${baseY} Z`;

    let dots = "";
    pts.forEach((p, i) => {
      if (vals[i] > 0 || i === DAYS - 1) {
        const fmt = days[i].toLocaleDateString("en-US", { month: "short", day: "numeric" });
        dots += `<circle class="tl-dot" cx="${p[0].toFixed(1)}" cy="${p[1].toFixed(1)}" r="3"${i === DAYS - 1 ? ' style="fill:var(--teal)"' : ""}><title>${fmt}: ${vals[i]} found</title></circle>`;
      }
    });

    let labels = "";
    [0, 4, 8, 13].forEach(i => {
      labels += `<text class="axis-label" x="${px(i).toFixed(1)}" y="${baseY + 15}" text-anchor="middle">${days[i].toLocaleDateString("en-US", { month: "short", day: "numeric" })}</text>`;
    });

    body.innerHTML = `<div class="chart-anim">
      <svg class="chart-svg" viewBox="0 0 ${W} ${H}" role="img" aria-label="Jobs found per day, last 14 days">
        <defs><linearGradient id="tl-grad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--teal)" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="var(--teal)" stop-opacity="0"/>
        </linearGradient></defs>
        <line class="grid-line" x1="${padL}" y1="${py(maxN).toFixed(1)}" x2="${W - padR}" y2="${py(maxN).toFixed(1)}"/>
        <text class="axis-label" x="${padL - 7}" y="${(py(maxN) + 3).toFixed(1)}" text-anchor="end">${maxN}</text>
        <line x1="${padL}" y1="${baseY}" x2="${W - padR}" y2="${baseY}" stroke="var(--line-2)" stroke-width="1"/>
        <text class="axis-label" x="${padL - 7}" y="${baseY + 3}" text-anchor="end">0</text>
        <path class="tl-fill" d="${area}" fill="url(#tl-grad)"/>
        <path class="tl-line" d="${line}"/>
        ${dots}${labels}
      </svg></div>`;

    const note = $("timeline-note");
    if (note) note.textContent = `${total} found · last 14 days`;
    animateChart(body);
  }

  function renderSources(apps) {
    const body = $("sources-body");
    if (!body) return;
    if (!apps.length) { body.innerHTML = insightEmpty(); return; }

    const counts = {};
    apps.forEach(a => { const k = srcKey(a); counts[k] = (counts[k] || 0) + 1; });
    let entries = Object.entries(counts).sort((x, y) => y[1] - x[1]);
    const totalSources = entries.length;
    if (entries.length > 5) {
      const rest = entries.slice(4).reduce((s, e) => s + e[1], 0);
      entries = entries.slice(0, 4).concat([["other", rest]]);
    }

    const total = apps.length;
    const r = 42, C = 2 * Math.PI * r;
    const gap = entries.length > 1 ? 2.5 : 0;
    let off = 0, segs = "";
    entries.forEach(([name, n], i) => {
      const len = (n / total) * C;
      const dash = Math.max(len - gap, 0.5);
      const color = INSIGHT_SERIES[i % INSIGHT_SERIES.length];
      segs += `<circle cx="58" cy="58" r="${r}" fill="none" stroke="${color}" stroke-width="13"
        stroke-dasharray="${dash.toFixed(2)} ${(C - dash).toFixed(2)}" stroke-dashoffset="${(-off).toFixed(2)}">
        <title>${escapeHtml(name)}: ${n} (${Math.round((n / total) * 100)}%)</title></circle>`;
      off += len;
    });

    const legend = entries.map(([name, n], i) => `
      <div class="legend-row" style="transition-delay:${(0.15 + i * 0.08).toFixed(2)}s">
        <span class="legend-dot" style="background:${INSIGHT_SERIES[i % INSIGHT_SERIES.length]}"></span>
        <span class="legend-name">${escapeHtml(name)}</span>
        <span class="legend-val">${n}<span class="lp">${Math.round((n / total) * 100)}%</span></span>
      </div>`).join("");

    body.innerHTML = `
      <div class="chart-anim donut-wrap">
        <div class="donut"><svg viewBox="0 0 116 116">
          <g transform="rotate(-90 58 58)">${segs}</g>
          <text class="donut-num" x="58" y="58" text-anchor="middle" dominant-baseline="central">${total}</text>
          <text class="donut-sub" x="58" y="78" text-anchor="middle">jobs</text>
        </svg></div>
        <div class="donut-legend">${legend}</div>
      </div>`;

    const note = $("sources-note");
    if (note) note.textContent = `${totalSources} source${totalSources === 1 ? "" : "s"}`;
    animateChart(body);
  }

  function renderArchetypeMix(apps) {
    const body = $("arch-body");
    if (!body) return;
    const scored = apps.filter(a => a.fit_score != null);
    if (!scored.length) {
      body.innerHTML = insightEmpty("No scored jobs yet");
      return;
    }

    const counts = {};
    scored.forEach(a => { const k = a.archetype_label || "Unclassified"; counts[k] = (counts[k] || 0) + 1; });
    let entries = Object.entries(counts).sort((x, y) => y[1] - x[1]);
    if (entries.length > 7) {
      const rest = entries.slice(6).reduce((s, e) => s + e[1], 0);
      entries = entries.slice(0, 6).concat([["Other", rest]]);
    }
    const max = Math.max(...entries.map(e => e[1]), 1);

    const rows = entries.map(([name, n], i) => {
      const mutedBar = ["Unclassified", "Unknown / Other", "Other"].includes(name);
      const color = mutedBar ? "var(--muted-3)" : INSIGHT_SERIES[i % INSIGHT_SERIES.length];
      return `<div class="hbar" title="${escapeHtml(name)}: ${n}">
        <div class="hl">${escapeHtml(name)}</div>
        <div class="ht"><div class="hf" style="width:${Math.max((n / max) * 100, 2).toFixed(1)}%; --hc:${color}; transition-delay:${i * 70}ms"></div></div>
        <div class="hn">${n}</div>
      </div>`;
    }).join("");

    body.innerHTML = `<div class="chart-anim hbar-list">${rows}</div>`;
    const note = $("arch-note");
    if (note) note.textContent = `${scored.length} scored`;
    animateChart(body);
  }

  function renderInsights() {
    const apps = state.applications || [];
    renderFunnel(apps);
    renderHistogram(apps);
    renderTimeline(apps);
    renderSources(apps);
    renderArchetypeMix(apps);
    const note = $("insights-note");
    if (note) note.textContent = apps.length ? `computed from ${apps.length} applications` : "awaiting first scan";
  }

  // ============================================================
  // ADVANCED FILTER CONTROLS — sort / archetype / source / min-score
  // ============================================================
  function syncFilterOptions(apps) {
    const archSel = $("archetype-select"), srcSel = $("source-select");
    if (archSel) {
      const labels = [...new Set(apps.map(a => a.archetype_label).filter(Boolean))].sort();
      const hasNone = apps.some(a => !a.archetype_label);
      const prev = archSel.value || "all";
      archSel.innerHTML = `<option value="all">All archetypes</option>` +
        labels.map(l => `<option value="${escapeHtml(l)}">${escapeHtml(l)}</option>`).join("") +
        (hasNone ? `<option value="__none__">Unclassified</option>` : "");
      archSel.value = [...archSel.options].some(o => o.value === prev) ? prev : "all";
      state.archFilter = archSel.value;
    }
    if (srcSel) {
      const sources = [...new Set(apps.map(srcKey))].sort();
      const prev = srcSel.value || "all";
      srcSel.innerHTML = `<option value="all">All sources</option>` +
        sources.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join("");
      srcSel.value = [...srcSel.options].some(o => o.value === prev) ? prev : "all";
      state.srcFilter = srcSel.value;
    }
    updateAdvControls();
  }

  function updateAdvControls() {
    const active = state.archFilter !== "all" || state.srcFilter !== "all" || state.minScore > 0;
    const rb = $("reset-filters");
    if (rb) rb.hidden = !active;
    const as = $("archetype-select");
    if (as) as.classList.toggle("is-active", state.archFilter !== "all");
    const ss = $("source-select");
    if (ss) ss.classList.toggle("is-active", state.srcFilter !== "all");
  }

  function resetFilters() {
    state.archFilter = "all";
    state.srcFilter = "all";
    state.minScore = 0;
    state.search = "";
    const si = $("search-input"); if (si) si.value = "";
    const as = $("archetype-select"); if (as) as.value = "all";
    const ss = $("source-select"); if (ss) ss.value = "all";
    $$("#min-score-seg button").forEach(b => b.classList.toggle("active", b.dataset.min === "0"));
    updateAdvControls();
    setFilter("all");
  }

  // ============================================================
  // BOOT
  // ============================================================
  document.addEventListener("DOMContentLoaded", () => {
    renderTodayDate();
    renderSessionTime();
    setInterval(renderSessionTime, 30000);

    const enableAnimations = () => document.body.classList.add("is-ready");
    if (document.visibilityState === "visible") {
      requestAnimationFrame(enableAnimations);
    } else {
      document.addEventListener("visibilitychange", function onVis() {
        if (document.visibilityState === "visible") {
          document.removeEventListener("visibilitychange", onVis);
          requestAnimationFrame(enableAnimations);
        }
      });
    }

    $$(".filter-pill").forEach(btn => {
      btn.addEventListener("click", () => setFilter(btn.dataset.filter));
    });
    $("search-input").addEventListener("input", (e) => {
      state.search = e.target.value;
      renderTable(state.applications);
    });

    const sortSel = $("sort-select");
    if (sortSel) sortSel.addEventListener("change", (e) => {
      state.sort = e.target.value;
      renderTable(state.applications);
    });
    const archSel = $("archetype-select");
    if (archSel) archSel.addEventListener("change", (e) => {
      state.archFilter = e.target.value;
      updateAdvControls();
      renderTable(state.applications);
    });
    const srcSel = $("source-select");
    if (srcSel) srcSel.addEventListener("change", (e) => {
      state.srcFilter = e.target.value;
      updateAdvControls();
      renderTable(state.applications);
    });
    $$("#min-score-seg button").forEach(btn => {
      btn.addEventListener("click", () => {
        state.minScore = parseInt(btn.dataset.min, 10) || 0;
        $$("#min-score-seg button").forEach(b => b.classList.toggle("active", b === btn));
        updateAdvControls();
        renderTable(state.applications);
      });
    });
    const resetBtn = $("reset-filters");
    if (resetBtn) resetBtn.addEventListener("click", resetFilters);
    $("drawer-overlay").addEventListener("click", closeDrawer);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeDrawer(); });

    renderSparks();
    Promise.all([loadArchetypes(), loadData()]).then(() => {
      connectSSE();
    });
  });

  window.setStatus = setStatus;
  window.saveNotes = saveNotes;
  window.openJobLink = openJobLink;
  window.openCV = openCV;
  window.downloadFile = downloadFile;
  window.closeDrawer = closeDrawer;
  window.toggleEvaluation = toggleEvaluation;
  window.resetFilters = resetFilters;
</script>

</body>
</html>
